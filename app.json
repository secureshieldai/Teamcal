{
  "expo": {
    "name": "TeamCal",
    "slug": "TeamCal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AppIcon.png",
    "splash": {
      "image": "./assets/splashscreen.jpeg",
      "resizeMode": "cover",
      "backgroundColor": "#FFFFFF"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.teamcal.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.teamcal.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/AppIcon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND"
      ]
    },
    "web": {
      "favicon": "./assets/AppIcon.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TeamCal to scan meals and product barcodes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TeamCal to analyze a food photo."
        }
      ],
      "expo-font"
      ,
      [
        "expo-audio",
        {
          "microphonePermission": "Allow TeamCal to record a voice note for your meal plan preferences."
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ],
      "expo-background-task",
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Allow TeamCal to read your step count and keep your daily progress in sync.",
          "NSHealthUpdateUsageDescription": "TeamCal does not write health data.",
          "background": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "178a09a8-8bd6-4865-9847-e619203fd8e0"
      }
    },
    "owner": "secure23"
  }
}
