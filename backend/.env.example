# TeamCal Backend Environment Variables
# Copy this file to .env and fill in your actual values

# ─── Server ───────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Supabase ─────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ─── JWT ──────────────────────────────────────────
# Generate a secure random string (min 64 chars recommended)
JWT_SECRET=your_jwt_secret_here_make_it_long_and_random
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=your_refresh_secret_here_also_long_and_random
JWT_REFRESH_EXPIRES_IN=90d

# ─── OpenAI (Primary AI for all features) ───────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ─── CORS ─────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081

# ─── Rate Limiting ────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AI_RATE_LIMIT_MAX=20

# ─── File Uploads ─────────────────────────────────
UPLOAD_MAX_SIZE_MB=10

# ─── Stripe (Payment Processing) ──────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PLATFORM_FEE_BPS=1000
STRIPE_DEFAULT_COUNTRY=US
PUBLIC_APP_URL=http://localhost:8081

# ─── Firebase Admin SDK ───────────────────────────
# Get from: Firebase Console > Project settings > Service accounts
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n"

# ─── Email (Resend) ───────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=TeamCal <noreply@yourdomain.com>

# ─── SMTP / Nodemailer (Alternative) ──────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ─── OTP Secret ───────────────────────────────────
# Generate another secure random string
OTP_SECRET=your_otp_secret_here_long_and_random

# ─── USDA Food Database ───────────────────────────
# Get from: https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=your_usda_api_key_here

# ─── Open Food Facts ──────────────────────────────
OPEN_FOOD_FACTS_CONTACT=your_email@example.com

# ─── Social Platform Integration ──────────────────
PUBLIC_API_URL=https://api.yourdomain.com
MOBILE_APP_SCHEME=teamcal
SOCIAL_TOKEN_ENCRYPTION_KEY=your_encryption_key_here

# Social Media API Keys (Optional)
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=TeamCal/1.0
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
WHATSAPP_CLIENT_ID=your_whatsapp_client_id
WHATSAPP_CLIENT_SECRET=your_whatsapp_client_secret
