# ─── Server ───────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Supabase ─────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ─── JWT ──────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=90d

# ─── Gemini AI (for meal scanner + Blaze coach) ───
GEMINI_API_KEY=your_gemini_api_key_here

# USDA FoodData Central (server-side only; obtain from api.data.gov)
USDA_FDC_API_KEY=your_usda_fooddata_central_api_key
# Real contact used to identify TeamCal to Open Food Facts
OPEN_FOOD_FACTS_CONTACT=your_email@example.com

# Email verification (SMTP / Nodemailer)
# Gmail requires 2-Step Verification and a 16-character App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=TeamCal <your_email@gmail.com>
# Optional; falls back to JWT_SECRET. Use a separate long random value in production.
OTP_SECRET=change_this_to_a_separate_long_random_secret
# ─── CORS ─────────────────────────────────────────
# Comma-separated list of allowed origins
# Use * to allow all origins (React Native / mobile apps send no origin header)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081

# ─── Firebase (optional — needed for Google/Apple sign-in) ────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── Rate Limiting ────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=20

# ─── File Uploads ─────────────────────────────────
UPLOAD_MAX_SIZE_MB=10
SUPABASE_UPLOAD_BUCKET=teamcal-uploads

# Stripe Connect (server-side secrets only)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# 1000 basis points = 10% TeamCal platform fee
STRIPE_PLATFORM_FEE_BPS=1000
STRIPE_DEFAULT_COUNTRY=US
# Public frontend URL used by Stripe onboarding and Checkout redirects
PUBLIC_APP_URL=http://localhost:8081
