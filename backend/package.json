{
  "name": "teamcal-backend",
  "version": "1.0.0",
  "description": "Production-ready Node.js backend for TeamCal",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:e2e": "node scripts/staging-e2e.js",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@supabase/supabase-js": "^2.110.8",
    "bcryptjs": "2.4.3",
    "compression": "^1.8.1",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "7.3.1",
    "express-validator": "^7.3.2",
    "firebase-admin": "^14.2.0",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "^1.11.0",
    "multer": "1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "stripe": "^22.4.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "5.0.1",
    "winston": "3.13.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "setupFiles": [
      "./src/__tests__/setup.js"
    ],
    "coverageDirectory": "coverage"
  }
}
